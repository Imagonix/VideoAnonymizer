{
  "Docker": {
    "Mode": "Container"
  },
  "Standalone": {
    "Url": "http://0.0.0.0:5117",
    "OpenBrowser": false
  },
  "ObjectDetection": {
    "BaseUrl": "http://127.0.0.1:8765",
    "Port": 8765,
    "ExecutablePath": "/app/object-detection-wrapper.sh",
    "WorkingDirectory": "/opt/object-detection",
    "ModelsPath": "/data/models",
    "AutoDetectGpuSettings": true,
    "DetectionWorkerCount": 4,
    "DetectionBatchSize": 8,
    "DetectionQueueCapacity": 100,
    "DetectionSaveBatchSize": 25
  },
  "Database": {
    "Provider": "Sqlite",
    "FilePath": "/data/App_Data/videoanonymizer.db"
  },
  "Anonymization": {
    "InterpolateTrackedObjects": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
