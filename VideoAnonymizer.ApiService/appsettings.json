{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HttpClient": {
    "StandardResilienceTimeoutSeconds": 300
  },
  "ObjectDetection": {
    "RequestTimeoutSeconds": 300
  },
  "Anonymization": {
    "InterpolateTrackedObjects": true
  }
}
