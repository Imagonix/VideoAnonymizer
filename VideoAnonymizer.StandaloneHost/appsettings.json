{
  "Standalone": {
    "Url": "http://127.0.0.1:5117",
    "OpenBrowser": true
  },
  "ObjectDetection": {
    "BaseUrl": "http://127.0.0.1:8765",
    "Port": 8765,
    "ExecutablePath": "ObjectDetection/VideoAnonymizer.ObjectDetection.exe",
    "WorkingDirectory": "ObjectDetection",
    "ModelsPath": "data/models",
    "AutoDetectGpuSettings": true,
    "DetectionWorkerCount": 2,
    "DetectionBatchSize": 8,
    "DetectionQueueCapacity": 50,
    "DetectionSaveBatchSize": 25
  },
  "Database": {
    "Provider": "Sqlite",
    "FilePath": "App_Data/videoanonymizer.db"
  },
  "Anonymization": {
    "InterpolateTrackedObjects": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
