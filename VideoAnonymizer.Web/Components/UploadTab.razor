@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using VideoAnonymizer.Web.Shared.DTO

<MudPaper Class="pa-6" Style="flex: 1; min-height: 0; display: flex; flex-direction: column; overflow-y: auto;">
    <MudStack Spacing="4">

        <MudText Typo="Typo.h6">Import a new video</MudText>

        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudFileUpload @ref="_fileUpload" T="IBrowserFile"
                           FilesChanged="OnFilesChanged"
                           Accept="video/*"
                           Hidden="true">
                <CustomContent>
                    <MudButton HtmlTag="label"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.VideoFile"
                               OnClick="@context.OpenFilePickerAsync"
                               Disabled="@IsBusy">
                        Select Video
                    </MudButton>
                </CustomContent>
                <SelectedTemplate />
            </MudFileUpload>

            @if (string.IsNullOrWhiteSpace(SelectedFileName))
            {
                <MudText Typo="Typo.body1">
                    Choose a video file.
                </MudText>
            }

            @if (!string.IsNullOrWhiteSpace(SelectedFileName))
            {
                <MudPaper Outlined="true" Class="pa-3">
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" />
                        <MudText Typo="Typo.body1">@SelectedFileName</MudText>
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
        <MudDivider />
        <MudStack Spacing="1">
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.body1">Detection interval (ms)</MudText>

                <MudTooltip Text="Time between analyzed frames. A smaller detection interval improves object tracking, but increases processing time."
                            Placement="Placement.Right">
                    <MudIconButton Icon="@Icons.Material.Filled.HelpOutline"
                                   Size="Size.Small"
                                   Color="Color.Default"
                                   Disabled="@IsBusy" />
                </MudTooltip>
            </MudStack>
            <MudNumericField T="int"
                             Value="DetectionIntervalMs"
                             ValueChanged="OnDetectionIntervalChanged"
                             Variant="Variant.Outlined"
                             Min="50"
                             Max="5000"
                             Step="50"
                             Immediate="true"
                             HideSpinButtons="false"
                             Disabled="@IsBusy"
                             Style="width: 140px;" />
        </MudStack>
        <MudDivider />
        <MudStack AlignItems="AlignItems.Start">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Search"
                       Disabled="@(!CanDetect)"
                       OnClick="DetectObjectsClicked">
                Detect Objects
            </MudButton>
        </MudStack>

        @if (ExistingVideos?.Count > 0)
        {
            <MudDivider />
            <MudText Typo="Typo.h6">Imported Videos</MudText>

            <MudPaper Outlined="true" Class="pa-0">
                <MudTable Items="@SortedVideos" Hover="true" Dense="true" Elevation="0">
                    <HeaderContent>
                        <MudTh aria-sort="@GetAriaSort(VideoSortColumn.Filename)">
                            <button type="button" class="sort-header" data-testid="sort-filename"
                                    title="Sort by file name"
                                    @onclick="() => ToggleSort(VideoSortColumn.Filename)">
                                File Name
                                @if (_sortColumn == VideoSortColumn.Filename)
                                {
                                    <MudIcon Icon="@(_sortAscending ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)"
                                             Size="Size.Small" />
                                }
                            </button>
                        </MudTh>
                        <MudTh><MudText Typo="Typo.body2">Status</MudText></MudTh>
                        <MudTh aria-sort="@GetAriaSort(VideoSortColumn.Uploaded)">
                            <button type="button" class="sort-header" data-testid="sort-uploaded"
                                    title="Sort by upload time"
                                    @onclick="() => ToggleSort(VideoSortColumn.Uploaded)">
                                Uploaded
                                @if (_sortColumn == VideoSortColumn.Uploaded)
                                {
                                    <MudIcon Icon="@(_sortAscending ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)"
                                             Size="Size.Small" />
                                }
                            </button>
                        </MudTh>
                        <MudTh Style="width: 56px;"></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="File Name">
                            <div data-testid="existing-video-row"
                                 role="button"
                                 tabindex="0"
                                 aria-label="@($"Open {context.OriginalFileName}")"
                                 @onclick="@(() => OnOpenExistingVideoAsync(context.Id))"
                                 @onkeydown="@((e) => OnExistingVideoKeyDownAsync(e, context.Id))"
                                 style="cursor: pointer; padding: 4px 0;">
                                <MudText Typo="Typo.body1">@context.OriginalFileName</MudText>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Status">
                            <MudText Typo="Typo.body2"
                                     data-testid="video-status"
                                     Class="mud-text-secondary">
                                @context.Status
                            </MudText>
                        </MudTd>
                        <MudTd DataLabel="Uploaded">
                            <MudText Typo="Typo.body2"
                                     data-testid="video-uploaded"
                                     Class="mud-text-secondary">
                                @context.UploadedAtUtc.ToLocalTime().ToString("g")
                            </MudText>
                        </MudTd>
                        <MudTd DataLabel="Actions" Style="text-align: right;">
                            <MudTooltip Text="Delete working copy">
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Disabled="@IsBusy"
                                               data-testid="delete-working-copy"
                                               aria-label="Delete working copy"
                                               OnClick="@(() => OnDeleteRequested(context))" />
                            </MudTooltip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>

            @if (_deleteCandidate is not null)
            {
                <div class="confirm-backdrop" data-testid="delete-confirm-dialog"
                     style="position: fixed; inset: 0; z-index: 1500; display: flex; align-items: center; justify-content: center; background: rgba(0, 0, 0, 0.5);">
                    <MudPaper Class="pa-4 d-flex flex-column" Style="width: min(480px, calc(100vw - 32px)); gap: 12px;">
                        <MudText Typo="Typo.h6">Delete working copy</MudText>
                        <MudText Typo="Typo.body2">
                            Delete "@_deleteCandidate.OriginalFileName"? The source video, generated export, analysis and editor state, and related records managed by this deployment will be deleted.
                        </MudText>
                        <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="OnDeleteCancelled">
                                Cancel
                            </MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Error"
                                       data-testid="confirm-delete-working-copy"
                                       OnClick="OnDeleteConfirmed">
                                Delete working copy
                            </MudButton>
                        </MudStack>
                    </MudPaper>
                </div>
            }
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public EventCallback<IBrowserFile?> SelectedFileChanged { get; set; }

    [Parameter, EditorRequired]
    public EventCallback DetectObjects { get; set; }

    [Parameter]
    public EventCallback<Guid> OnExistingVideoSelected { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDeleteWorkingCopy { get; set; }

    [Parameter]
    public List<VideoDto>? ExistingVideos { get; set; }

    [Parameter]
    public string? SelectedFileName { get; set; }

    [Parameter]
    public int DetectionIntervalMs { get; set; } = 100;

    [Parameter]
    public EventCallback<int> DetectionIntervalMsChanged { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    private MudFileUpload<IBrowserFile>? _fileUpload;

    private enum VideoSortColumn
    {
        None,
        Filename,
        Uploaded
    }

    private VideoSortColumn _sortColumn = VideoSortColumn.None;
    private bool _sortAscending = true;
    private VideoDto? _deleteCandidate;

    private List<VideoDto> SortedVideos
    {
        get
        {
            if (ExistingVideos is null)
                return [];

            return _sortColumn switch
            {
                VideoSortColumn.Filename when _sortAscending =>
                    ExistingVideos
                        .OrderBy(v => v.OriginalFileName, StringComparer.OrdinalIgnoreCase)
                        .ThenBy(v => v.UploadedAtUtc)
                        .ThenBy(v => v.Id)
                        .ToList(),
                VideoSortColumn.Filename =>
                    ExistingVideos
                        .OrderByDescending(v => v.OriginalFileName, StringComparer.OrdinalIgnoreCase)
                        .ThenBy(v => v.UploadedAtUtc)
                        .ThenBy(v => v.Id)
                        .ToList(),
                VideoSortColumn.Uploaded when _sortAscending =>
                    ExistingVideos
                        .OrderBy(v => v.UploadedAtUtc)
                        .ThenBy(v => v.OriginalFileName)
                        .ThenBy(v => v.Id)
                        .ToList(),
                VideoSortColumn.Uploaded =>
                    ExistingVideos
                        .OrderByDescending(v => v.UploadedAtUtc)
                        .ThenBy(v => v.OriginalFileName)
                        .ThenBy(v => v.Id)
                        .ToList(),
                _ => ExistingVideos
                    .OrderByDescending(v => v.UploadedAtUtc)
                    .ThenBy(v => v.OriginalFileName)
                    .ThenBy(v => v.Id)
                    .ToList()
            };
        }
    }

    private void ToggleSort(VideoSortColumn column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private string GetAriaSort(VideoSortColumn column) =>
        _sortColumn == column
            ? (_sortAscending ? "ascending" : "descending")
            : "none";

    private void OnDeleteRequested(VideoDto video)
    {
        if (IsBusy)
            return;
        _deleteCandidate = video;
    }

    private void OnDeleteCancelled()
    {
        _deleteCandidate = null;
    }

    private async Task OnDeleteConfirmed()
    {
        if (_deleteCandidate is null)
            return;

        var videoId = _deleteCandidate.Id;
        _deleteCandidate = null;
        await OnDeleteWorkingCopy.InvokeAsync(videoId);
    }

    public async Task ClearFileInput()
    {
        if (_fileUpload == null)
        {
            return;
        }
        await _fileUpload.ClearAsync();
    }

    private bool CanDetect => !IsBusy && !string.IsNullOrWhiteSpace(SelectedFileName);

    private async Task OnFilesChanged(IBrowserFile? file)
    {
        await SelectedFileChanged.InvokeAsync(file);
    }

    private async Task OnDetectionIntervalChanged(int value)
    {
        DetectionIntervalMs = value;
        await DetectionIntervalMsChanged.InvokeAsync(value);
    }

    private async Task DetectObjectsClicked()
    {
        await DetectObjects.InvokeAsync();
    }

    private async Task OnOpenExistingVideoAsync(Guid videoId)
    {
        if (IsBusy)
            return;
        await OnExistingVideoSelected.InvokeAsync(videoId);
    }

    private async Task OnExistingVideoKeyDownAsync(KeyboardEventArgs e, Guid videoId)
    {
        if (IsBusy)
            return;

        if (e.Key is "Enter" or " ")
        {
            await OnExistingVideoSelected.InvokeAsync(videoId);
        }
    }
}

<style>
    .sort-header {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 0;
        border: none;
        background: transparent;
        color: inherit;
        font: inherit;
        cursor: pointer;
    }

    .sort-header:hover {
        color: var(--mud-palette-primary);
    }

    .sort-header:focus-visible {
        outline: 2px solid color-mix(in srgb, var(--mud-palette-primary) 70%, transparent);
        outline-offset: 2px;
    }
</style>
