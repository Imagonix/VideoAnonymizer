@using System.Text.Json
@using VideoAnonymizer.Web.Components.ReviewExport
@using VideoAnonymizer.Web.Modules.Actions
@using VideoAnonymizer.Web.Modules.Components
@using VideoAnonymizer.Web.Services
@using VideoAnonymizer.Web.Shared
@using VideoAnonymizer.Web.Shared.DTO
@implements IAsyncDisposable
@inject IHttpClientFactory HttpClientFactory
@inject IJobHubClient JobHubClient
@inject ISnackbar Snackbar

<MudPaper Class="pa-6" Style="flex: 1; min-height: 0; display: flex; flex-direction: column;">
    <MudStack Spacing="2" Style="flex: 1; min-height: 0;">
        <ReviewExportSettings BlurSizePercent="BlurSizePercent"
                               BlurSizePercentChanged="OnBlurSizeChanged"
                               TimeBufferMs="TimeBufferMs"
                               TimeBufferMsChanged="OnTimeBufferChanged">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <ActionHistoryPopover IsProcessing="_videoEditorProcessing || _activeTrackForwardCount > 0"
                                      HasErrors="_hasErrors"
                                      Items="_actionHistory" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           Disabled="!ShowEditor || _editorInputBlocked"
                           OnClick="OnStartAnonymizationClicked">
                    Export
                </MudButton>
            </MudStack>
        </ReviewExportSettings>

        @if (ShowEditor && VideoId.HasValue && !string.IsNullOrWhiteSpace(VideoSourceUrl))
        {
            <div style="position: relative; flex: 1; min-height: 0; display: flex; flex-direction: column;">
                <VideoEditor @ref="_videoEditor"
                             VideoId="@VideoId.Value"
                             VideoSourceUrl="@VideoSourceUrl"
                             Frames="@Frames"
                             BlurSizePercent="@BlurSizePercent"
                             TimeBufferMs="@TimeBufferMs"
                             InterpolateTrackedObjects="@InterpolateTrackedObjects"
                             OnAction="OnVideoEditorAction" />

                @if (_editorInputBlocked)
                {
                    <div style="position: absolute; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; background: rgba(0, 0, 0, 0.35);">
                        <MudPaper Class="pa-4 d-flex flex-column align-center" Style="gap: 12px;">
                            <MudProgressCircular Indeterminate="true" Color="Color.Secondary" />
                            <MudText Typo="Typo.body2">Finishing pending editor changes...</MudText>
                        </MudPaper>
                    </div>
                }
            </div>
        }
    </MudStack>
</MudPaper>

@code {
    private readonly List<ActionHistoryItem> _actionHistory = [];
    private readonly VideoEditorActionQueue _actionQueue;
    private readonly VideoEditorUndoRedoState _undoRedoState = new();
    private VideoEditor? _videoEditor;
    private IDisposable? _trackForwardCompletedSubscription;
    private readonly Dictionary<Guid, (ActionHistoryItem Item, string SeedObjectId, TrackForwardAction Action)> _pendingTrackForwardJobs = [];
    private List<AnalyzedFrameDto> _capturedFrames = [];
    private bool _videoEditorProcessing;
    private bool _editorInputBlocked;
    private int _activeTrackForwardCount;
    private bool _hasErrors;
    private Guid? _lastVideoId;

    public ReviewExportTab()
    {
        _actionQueue = new VideoEditorActionQueue(OnQueueProcessingChangedAsync);
    }

    [Parameter]
    public Guid? VideoId { get; set; }

    [Parameter]
    public string? VideoSourceUrl { get; set; }

    [Parameter]
    public List<AnalyzedFrameDto> Frames { get; set; } = [];

    [Parameter]
    public bool ShowEditor { get; set; }

    [Parameter]
    public bool InterpolateTrackedObjects { get; set; } = true;

    [Parameter, EditorRequired]
    public EventCallback StartAnonymization { get; set; }

    [Parameter]
    public EventCallback TrackingCompleted { get; set; }

    [Parameter]
    public int BlurSizePercent { get; set; } = 120;

    [Parameter]
    public EventCallback<int> BlurSizePercentChanged { get; set; }

    [Parameter]
    public int TimeBufferMs { get; set; } = 300;

    [Parameter]
    public EventCallback<int> TimeBufferMsChanged { get; set; }

    public IReadOnlyList<AnalyzedFrameDto> CapturedFrames => _capturedFrames;

    protected override void OnInitialized()
    {
        _trackForwardCompletedSubscription = JobHubClient.OnTrackForwardCompleted(OnTrackForwardCompletedAsync);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (VideoId.HasValue)
        {
            if (_lastVideoId != VideoId)
            {
                _lastVideoId = VideoId;
                await LoadActionHistoryAsync();
            }
        }
        else
        {
            _lastVideoId = null;
        }
    }

    private async Task LoadActionHistoryAsync()
    {
        if (VideoId is null) return;
        try
        {
            using var client = HttpClientFactory.CreateClient("ApiService");
            var persister = new VideoEditorActionPersister(client);
            var actions = await persister.LoadActionHistoryAsync(VideoId.Value);
            _undoRedoState.DeserializeActions(VideoId.Value, actions);

            _actionHistory.Clear();
            for (var i = 0; i < _undoRedoState.Count; i++)
            {
                var displayItem = _undoRedoState.GetDisplayItem(i);
                if (displayItem is not null)
                    _actionHistory.Add(displayItem);
            }
        }
        catch
        {
        }
    }

    private Task OnQueueProcessingChangedAsync(bool isProcessing) =>
        InvokeAsync(() =>
        {
            _videoEditorProcessing = isProcessing;
            if (!isProcessing)
            {
                _editorInputBlocked = false;
            }

            StateHasChanged();
        });

    private Task OnVideoEditorAction(VideoEditorAction action)
    {
        if (_editorInputBlocked && action is UndoAction or RedoAction)
            return Task.CompletedTask;

        if (action is UndoAction or RedoAction && _actionQueue.HasPendingActions)
        {
            _editorInputBlocked = true;
            _ = InvokeAsync(StateHasChanged);
        }

        _actionQueue.Enqueue(() => ProcessVideoEditorActionAsync(action));
        return Task.CompletedTask;
    }

    private async Task ProcessVideoEditorActionAsync(VideoEditorAction action)
    {
        using var client = HttpClientFactory.CreateClient("ApiService");
        var persister = new VideoEditorActionPersister(client);

        switch (action)
        {
            case UndoAction:
                await ApplyUndoRedoAsync(persister, isRedo: false);
                break;

            case RedoAction:
                await ApplyUndoRedoAsync(persister, isRedo: true);
                break;

            case TrackForwardAction a:
                await ApplyTrackForwardAsync(persister, a);
                break;

            default:
                await PersistActionAsync(persister, action);
                break;
        }
    }

    private async Task ApplyTrackForwardAsync(VideoEditorActionPersister persister, TrackForwardAction action)
    {
        var item = AddAction(VideoEditorActionDescriptions.Get(action));
        var jobId = Guid.NewGuid();

        try
        {
            var job = await persister.TrackForwardAsync(action, jobId);
            _pendingTrackForwardJobs[job.JobId] = (item, action.Object.Id.ToString(), action);
            _activeTrackForwardCount++;
            Snackbar.Add("Tracking started.", Severity.Info);
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            _activeTrackForwardCount = Math.Max(0, _activeTrackForwardCount - 1);
            MarkActionFailed(item);
        }
    }

    private Task OnTrackForwardCompletedAsync(TrackForwardCompletedMessage message) =>
        InvokeAsync(async () =>
        {
            if (!_pendingTrackForwardJobs.TryGetValue(message.JobId, out var trackingInfo))
                return;

            if (VideoId.HasValue && message.VideoId != VideoId.Value)
                return;

            var (item, seedObjectId, action) = trackingInfo;
            _pendingTrackForwardJobs.Remove(message.JobId);
            _activeTrackForwardCount = Math.Max(0, _activeTrackForwardCount - 1);

            if (!string.Equals(message.Status, SharedConstants.SignalR.Status.Completed, StringComparison.OrdinalIgnoreCase)
                || message.Result is null)
            {
                if (item is not null)
                {
                    item.Status = ActionStatus.Failed;
                }

                _hasErrors = true;
                Snackbar.Add(
                    string.IsNullOrWhiteSpace(message.Error)
                        ? "Tracking failed."
                        : $"Tracking failed: {message.Error}",
                    Severity.Error);

                if (_videoEditor is not null)
                {
                    await _videoEditor.ClearTrackingObjectId(seedObjectId);
                }

                StateHasChanged();
                return;
            }

            item.Status = ActionStatus.Success;
            item.CreatedObjectIds = message.CreatedObjects.Select(o => o.Id).ToList();
            item.CreatedObjectDtos = message.CreatedObjects;

            var trackForwardData = JsonSerializer.Serialize(new ActionDataTrackForward(
                action.AnalyzedFrameId, action.Object, message.CreatedObjects, message.Result.TrackId));
            using var recordClient = HttpClientFactory.CreateClient("ApiService");
            var recordPersister = new VideoEditorActionPersister(recordClient);
            var actionId = await recordPersister.RecordRawActionAsync(VideoId!.Value, "track-forward", trackForwardData);

            _undoRedoState.Add(action, item, actionId);

            if (_videoEditor is not null)
            {
                await _videoEditor.ClearTrackingObjectId(seedObjectId);
            }

            Snackbar.Add($"Track {message.Result.TrackId}: forward tracking completed", Severity.Info);
            await TrackingCompleted.InvokeAsync();
            StateHasChanged();
        });

    private async Task PersistActionAsync(VideoEditorActionPersister persister, VideoEditorAction action)
    {
        var item = AddAction(VideoEditorActionDescriptions.Get(action));

        try
        {
            await persister.SaveAsync(action);
            item.Status = ActionStatus.Success;
            var actionId = await persister.RecordActionAsync(VideoId!.Value, action);
            _undoRedoState.Add(action, item, actionId);
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            MarkActionFailed(item);
        }
    }

    private async Task ApplyUndoRedoAsync(VideoEditorActionPersister persister, bool isRedo)
    {
        var operation = _undoRedoState.Begin(isRedo);
        if (operation is null)
            return;

        try
        {
            await persister.ApplyUndoRedoAsync(operation.Action, isRedo, _videoEditor, ApplySettingsFromHistoryAsync, operation.DisplayItem);

            if (operation.ActionId != Guid.Empty)
            {
                await persister.ToggleActionUndoneAsync(VideoId!.Value, operation.ActionId, !isRedo);
            }

            _undoRedoState.Complete(operation, isRedo);

            if (operation.Action is TrackForwardAction && !isRedo)
            {
                await TrackingCompleted.InvokeAsync();
            }

            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            _undoRedoState.Rollback(isRedo);
            Snackbar.Add(isRedo ? "Failed to redo changes." : "Failed to undo changes.", Severity.Error);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplySettingsFromHistoryAsync(AnonymizationSettingsDto settings)
    {
        BlurSizePercent = settings.BlurSizePercent;
        TimeBufferMs = settings.TimeBufferMs;

        await BlurSizePercentChanged.InvokeAsync(settings.BlurSizePercent);
        await TimeBufferMsChanged.InvokeAsync(settings.TimeBufferMs);
        await InvokeAsync(StateHasChanged);
    }

    private ActionHistoryItem AddAction(string description)
    {
        var item = new ActionHistoryItem(description, DateTime.UtcNow);
        _actionHistory.Add(item);
        if (_actionHistory.Count > 20)
        {
            _actionHistory.RemoveAt(0);
        }

        return item;
    }

    private void MarkActionFailed(ActionHistoryItem item)
    {
        item.Status = ActionStatus.Failed;
        _hasErrors = true;
        _ = InvokeAsync(StateHasChanged);
        Snackbar.Add("Failed to save changes. Please refresh the page.", Severity.Error);
    }

    private static string BuildTrackForwardSummary(TrackForwardResponseDto result)
    {
        var summary = $"Track {result.TrackId}: created {result.CreatedDetections}, skipped {result.SkippedConflicts}";
        if (result.ReacquiredCount > 0)
        {
            summary += $", reacquired {result.ReacquiredCount}";
        }

        return string.IsNullOrWhiteSpace(result.StoppedReason)
            ? summary
            : $"{summary}, stopped: {result.StoppedReason}";
    }

    private async Task OnStartAnonymizationClicked()
    {
        if (_videoEditor is null)
            return;

        _capturedFrames = (await _videoEditor.GetFramesAsync()).ToList();
        await StartAnonymization.InvokeAsync();
    }

    private async Task OnBlurSizeChanged(int value)
    {
        var before = new AnonymizationSettingsDto { BlurSizePercent = BlurSizePercent, TimeBufferMs = TimeBufferMs };
        BlurSizePercent = value;
        await BlurSizePercentChanged.InvokeAsync(value);
        await SaveSettingsAsync(before);
    }

    private async Task OnTimeBufferChanged(int value)
    {
        var before = new AnonymizationSettingsDto { BlurSizePercent = BlurSizePercent, TimeBufferMs = TimeBufferMs };
        TimeBufferMs = value;
        await TimeBufferMsChanged.InvokeAsync(value);
        await SaveSettingsAsync(before);
    }

    private Task SaveSettingsAsync(AnonymizationSettingsDto? beforeState = null)
    {
        if (VideoId is null)
            return Task.CompletedTask;

        var afterState = new AnonymizationSettingsDto { BlurSizePercent = BlurSizePercent, TimeBufferMs = TimeBufferMs };
        var before = beforeState ?? afterState;

        return OnVideoEditorAction(new SettingsUpdatedAction
        {
            VideoId = VideoId.Value,
            BeforeState = before,
            AfterState = afterState
        });
    }

    public async ValueTask DisposeAsync()
    {
        _trackForwardCompletedSubscription?.Dispose();
        await _actionQueue.DisposeAsync();
    }
}
