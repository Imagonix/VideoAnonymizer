@using VideoAnonymizer.Web.Components.ReviewExport
@using VideoAnonymizer.Web.Modules.Actions
@using VideoAnonymizer.Web.Modules.Components
@using VideoAnonymizer.Web.Services
@using VideoAnonymizer.Web.Shared
@using VideoAnonymizer.Web.Shared.DTO
@implements IAsyncDisposable
@inject IHttpClientFactory HttpClientFactory
@inject IJobHubClient JobHubClient
@inject ISnackbar Snackbar

<MudPaper Class="pa-6" Style="flex: 1; min-height: 0; display: flex; flex-direction: column;">
    <MudStack Spacing="2" Style="flex: 1; min-height: 0;">
        <ReviewExportSettings BlurSizePercent="BlurSizePercent"
                               BlurSizePercentChanged="OnBlurSizeChanged"
                               TimeBufferMs="TimeBufferMs"
                               TimeBufferMsChanged="OnTimeBufferChanged">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <ActionHistoryPopover IsProcessing="_actionCoordinator.HasPendingActions || _trackForwardCoordinator.ActiveCount > 0"
                                      HasErrors="_actionCoordinator.HasErrors || _trackForwardCoordinator.HasErrors"
                                      Items="_actionCoordinator.ActionHistory" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           Size="Size.Small"
                           Disabled="!ShowEditor || _editorInputBlocked"
                           OnClick="OnStartAnonymizationClicked">
                    Export
                </MudButton>
            </MudStack>
        </ReviewExportSettings>

        @if (ShowEditor && VideoId.HasValue && !string.IsNullOrWhiteSpace(VideoSourceUrl))
        {
            <div style="position: relative; flex: 1; min-height: 0; display: flex; flex-direction: column;">
                <VideoEditor @ref="_videoEditor"
                             VideoId="@VideoId.Value"
                             VideoSourceUrl="@VideoSourceUrl"
                             Frames="@Frames"
                             BlurSizePercent="@BlurSizePercent"
                             TimeBufferMs="@TimeBufferMs"
                             InterpolateTrackedObjects="@InterpolateTrackedObjects"
                             OnAction="OnVideoEditorAction" />

                @if (_editorInputBlocked)
                {
                    <div style="position: absolute; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; background: rgba(0, 0, 0, 0.35);">
                        <MudPaper Class="pa-4 d-flex flex-column align-center" Style="gap: 12px;">
                            <MudProgressCircular Indeterminate="true" Color="Color.Secondary" />
                            <MudText Typo="Typo.body2">Finishing pending editor changes...</MudText>
                        </MudPaper>
                    </div>
                }
            </div>
        }
    </MudStack>
</MudPaper>

@code {
    private VideoEditor? _videoEditor;
    private EditorActionCoordinator _actionCoordinator = default!;
    private TrackForwardCoordinator _trackForwardCoordinator = default!;
    private IDisposable? _trackForwardCompletedSubscription;
    private IDisposable? _trackForwardProgressSubscription;
    private List<AnalyzedFrameDto> _capturedFrames = [];
    private bool _editorInputBlocked;
    private Guid? _lastVideoId;

    [Parameter]
    public Guid? VideoId { get; set; }

    [Parameter]
    public string? VideoSourceUrl { get; set; }

    [Parameter]
    public List<AnalyzedFrameDto> Frames { get; set; } = [];

    [Parameter]
    public bool ShowEditor { get; set; }

    [Parameter]
    public bool InterpolateTrackedObjects { get; set; } = true;

    [Parameter, EditorRequired]
    public EventCallback StartAnonymization { get; set; }

    [Parameter]
    public EventCallback TrackingCompleted { get; set; }

    [Parameter]
    public int BlurSizePercent { get; set; } = 120;

    [Parameter]
    public EventCallback<int> BlurSizePercentChanged { get; set; }

    [Parameter]
    public int TimeBufferMs { get; set; } = 300;

    [Parameter]
    public EventCallback<int> TimeBufferMsChanged { get; set; }

    public IReadOnlyList<AnalyzedFrameDto> CapturedFrames => _capturedFrames;

    protected override void OnInitialized()
    {
        _actionCoordinator = new EditorActionCoordinator(
            HttpClientFactory,
            Snackbar,
            () => _videoEditor,
            ApplySettingsFromHistoryAsync,
            action => _trackForwardCoordinator.StartAsync(action),
            () => TrackingCompleted.InvokeAsync(),
            OnQueueProcessingChangedAsync,
            () => InvokeAsync(StateHasChanged));
        _trackForwardCoordinator = new TrackForwardCoordinator(
            HttpClientFactory,
            Snackbar,
            () => VideoId,
            () => _videoEditor,
            _actionCoordinator.AddAction,
            _actionCoordinator.AddUndoRedoAction,
            () => InvokeAsync(StateHasChanged),
            () => TrackingCompleted.InvokeAsync());
        _trackForwardCompletedSubscription = JobHubClient.OnTrackForwardCompleted(OnTrackForwardCompletedAsync);
        _trackForwardProgressSubscription = JobHubClient.OnTrackForwardProgress(OnTrackForwardProgressAsync);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (VideoId.HasValue)
        {
            if (_lastVideoId != VideoId)
            {
                _lastVideoId = VideoId;
                await _actionCoordinator.LoadAsync(VideoId.Value);
            }
        }
        else
        {
            _lastVideoId = null;
        }
    }

    private Task OnQueueProcessingChangedAsync(bool isProcessing) =>
        InvokeAsync(() =>
        {
            if (!isProcessing)
            {
                _editorInputBlocked = false;
            }

            StateHasChanged();
        });

    private Task OnVideoEditorAction(VideoEditorAction action)
    {
        if (_editorInputBlocked && action is UndoAction or RedoAction)
            return Task.CompletedTask;

        if (action is UndoAction or RedoAction && _actionCoordinator.HasPendingActions)
        {
            _editorInputBlocked = true;
            _ = InvokeAsync(StateHasChanged);
        }

        _actionCoordinator.Enqueue(action, VideoId!.Value);
        return Task.CompletedTask;
    }

    private Task OnTrackForwardProgressAsync(TrackForwardProgressMessage message) =>
        InvokeAsync(() => _trackForwardCoordinator.HandleProgressAsync(message));

    private Task OnTrackForwardCompletedAsync(TrackForwardCompletedMessage message) =>
        InvokeAsync(() => _trackForwardCoordinator.HandleCompletedAsync(message));

    private async Task ApplySettingsFromHistoryAsync(AnonymizationSettingsDto settings)
    {
        BlurSizePercent = settings.BlurSizePercent;
        TimeBufferMs = settings.TimeBufferMs;

        await BlurSizePercentChanged.InvokeAsync(settings.BlurSizePercent);
        await TimeBufferMsChanged.InvokeAsync(settings.TimeBufferMs);
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnStartAnonymizationClicked()
    {
        if (_videoEditor is null)
            return;

        _capturedFrames = (await _videoEditor.GetFramesAsync()).ToList();
        await StartAnonymization.InvokeAsync();
    }

    private async Task OnBlurSizeChanged(int value)
    {
        var before = new AnonymizationSettingsDto { BlurSizePercent = BlurSizePercent, TimeBufferMs = TimeBufferMs };
        BlurSizePercent = value;
        await BlurSizePercentChanged.InvokeAsync(value);
        await SaveSettingsAsync(before);
    }

    private async Task OnTimeBufferChanged(int value)
    {
        var before = new AnonymizationSettingsDto { BlurSizePercent = BlurSizePercent, TimeBufferMs = TimeBufferMs };
        TimeBufferMs = value;
        await TimeBufferMsChanged.InvokeAsync(value);
        await SaveSettingsAsync(before);
    }

    private Task SaveSettingsAsync(AnonymizationSettingsDto? beforeState = null)
    {
        if (VideoId is null)
            return Task.CompletedTask;

        var afterState = new AnonymizationSettingsDto { BlurSizePercent = BlurSizePercent, TimeBufferMs = TimeBufferMs };
        var before = beforeState ?? afterState;

        return OnVideoEditorAction(new SettingsUpdatedAction
        {
            VideoId = VideoId.Value,
            BeforeState = before,
            AfterState = afterState
        });
    }

    public async ValueTask DisposeAsync()
    {
        _trackForwardCompletedSubscription?.Dispose();
        _trackForwardProgressSubscription?.Dispose();
        _trackForwardCoordinator.Dispose();
        await _actionCoordinator.DisposeAsync();
    }
}
